# Shared LiveKit project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloud agent only
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
MOLTY_AGENT_NAME=molty-agent

# Raspberry Pi device
MOLTY_DEVICE_ID=prototype
MOLTY_WAKEWORD_MODEL=models/hey_livekit.onnx
MOLTY_WAKE_THRESHOLD=0.5
MOLTY_WAKE_DEBOUNCE_SECONDS=1.5
MOLTY_CALIBRATION=calibration.json
MOLTY_HARDWARE=false
# Defaults to true on Linux/Pi and false on macOS.
# MOLTY_STATUS_TONES=true

# Optional sounddevice indexes. Leave empty to use the OS defaults.
MOLTY_AUDIO_INPUT_DEVICE=
MOLTY_AUDIO_OUTPUT_DEVICE=
# Let PortAudio use ALSA's plug layer for fixed-rate devices such as Voice HAT.
PA_ALSA_PLUGHW=1

# Recommended after the local test: return {url, token, room_name} so the
# LiveKit API secret does not need to live on the Pi.
# MOLTY_TOKEN_ENDPOINT=https://example.com/molty/livekit-token
# MOLTY_TOKEN_ENDPOINT_BEARER=
