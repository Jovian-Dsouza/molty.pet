[Unit]
Description=Molty wake word, audio, and motion device
Wants=network-online.target
After=network-online.target sound.target molty-agent.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/molty.pet/firmware
EnvironmentFile=-/home/pi/molty.pet/firmware/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/molty.pet/firmware/.venv/bin/molty-device --dry-run
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
