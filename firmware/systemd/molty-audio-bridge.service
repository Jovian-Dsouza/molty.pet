[Unit]
Description=Molty LiveKit-to-Bluetooth audio bridge
Requires=bluealsa.service
After=bluetooth.service bluealsa.service
Before=molty-device.service

[Service]
Type=simple
User=pi
Group=pi
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=99
LimitMEMLOCK=infinity
ExecStart=/usr/bin/alsaloop -C hw:Loopback,1,0 -P molty_bt -r 48000 -c 1 -f S16_LE -t 20000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
